#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    subLayers = [
        @./hospital.usd@
    ]
    upAxis = "Z"
)

def "World"
{
    def Scope "ExitTargets"
    {
        def Xform "E1"
        {
            custom float2 grimoires:door_world = (-1.25, -2.75)
            custom string grimoires:exit_id = "E1"
            double3 xformOp:translate = (-1.25, -1.25, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "E2"
        {
            custom float2 grimoires:door_world = (-40.75, 33.25)
            custom string grimoires:exit_id = "E2"
            double3 xformOp:translate = (-40.25, 31.75, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "E3"
        {
            custom float2 grimoires:door_world = (20.75, 31.25)
            custom string grimoires:exit_id = "E3"
            double3 xformOp:translate = (19.25, 31.25, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "E4"
        {
            custom float2 grimoires:door_world = (-38.25, 8.75)
            custom string grimoires:exit_id = "E4"
            double3 xformOp:translate = (-39.75, 8.75, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

